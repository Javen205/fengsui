{
  "name": "@javen205/fengsui-adapter-wecom-bot",
  "version": "0.1.0",
  "description": "烽燧企业微信智能机器人插件：多机器人长连接、消息收发与事件路由",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
