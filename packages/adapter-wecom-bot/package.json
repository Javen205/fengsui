  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@javen205/fengsui-core": "workspace:^",
    "@wecom/aibot-node-sdk": "^1.0.1",
    "zod": "^4.6.7"
  }
}
