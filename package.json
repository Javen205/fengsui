{
  "name": "fengsui-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "烽燧（fengsui）统一消息发送工具：核心框架 + 可插拔渠道与传输实现",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "axios": "^1.7.0",
    "eslint": "^10.14.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "smtp-server": "^3.21.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  }
}
