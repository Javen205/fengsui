{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@javen205/fengsui-core": ["./packages/core/src/index.ts"],
      "@javen205/fengsui-http": ["./packages/http/src/index.ts"],
      "@javen205/fengsui-http-fetch": ["./packages/http-fetch/src/index.ts"],
      "@javen205/fengsui-http-axios": ["./packages/http-axios/src/index.ts"],
      "@javen205/fengsui-config-file": ["./packages/config-file/src/index.ts"],
      "@javen205/fengsui-adapter-email": ["./packages/adapter-email/src/index.ts"],
      "@javen205/fengsui-adapter-wecom-bot": ["./packages/adapter-wecom-bot/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tsup.config.base.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules", "packages/*/dist", "packages/*/node_modules"]
}
